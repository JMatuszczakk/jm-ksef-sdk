{
    "name": "jm-ksef",
    "version": "0.2.0",
    "description": "Plug-and-play JS/TS client for the Polish KSeF (Krajowy System e-Faktur) API v2 — authentication, invoice sessions (online + batch), querying, export, and verification. Zero dependencies, runs on Node 20+, browsers, and Cloudflare Workers (WebCrypto only).",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit",
        "pretest": "npm run build",
        "test": "node --test test/*.test.js",
        "prepublishOnly": "npm run build && npm test"
    },
    "keywords": [
        "ksef",
        "e-invoice",
        "faktura",
        "poland",
        "krajowy-system-e-faktur",
        "invoicing",
        "vat",
        "fa3",
        "webcrypto"
    ],
    "author": {
        "name": "Jakub Matuszczak",
        "email": "kubamatuszczak2@gmail.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JMatuszczakk/jm-ksef-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/JMatuszczakk/jm-ksef-sdk/issues"
    },
    "homepage": "https://github.com/JMatuszczakk/jm-ksef-sdk#readme",
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "typescript": "^5.7.0"
    }
}
